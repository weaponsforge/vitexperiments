{
  "name": "vite",
  "private": true,
  "version": "1.3.7",
  "type": "module",
  "description": "React app template created with Vite",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "types:check": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "report:view": "vite preview --outDir .vitest",
    "docker:dev": "vite --port=3000 --host",
    "docker:build": "export NODE_ENV=production && npm run build",
    "docker:report:view": "vite preview --outDir .vitest --host 0.0.0.0",
    "docker:test:watch:win": "vitest --no-open",
    "docker:test:ui": "vitest --ui --api.host 0.0.0.0",
    "docker:test:ui:win": "vitest --ui --api.host 0.0.0.0 --no-open",
    "info": "node ./scripts/envinfo",
    "base64": "node ./scripts/base64"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.18.4",
    "swr": "^2.5.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
